---
layout: layouts/base.njk
---
<article class="page page--grafschaft">
  {%- set heroBild = bild or '/assets/img/og-default.png' -%}
  <div class="stage" style="--hero-img: url('{{ heroBild | url }}{{ heroBild | v }}')">
    <div class="stage-inner">
      <section class="hero hero--wide">
        <div class="hero-inner reveal">
          {%- if wappen %}
          <img class="hero-wappen" src="{{ wappen | url }}{{ wappen | v }}" alt="Wappen {{ name }}" />
          {%- endif %}
          <p class="kicker">Grafschaft</p>
          <h1 class="hero-title">{{ name }}</h1>
          {%- if untertitel %}<p class="hero-sub">{{ untertitel }}</p>{%- endif %}
          <div class="rule"><span>✦</span></div>
        </div>
      </section>

      {# --- Abschnitts-Tabs (wie die Kapitel bei Charakteren) --- #}
      {%- set abschnitte = [
          { id: "geschichte", titel: "Geschichte" },
          { id: "orte", titel: "Orte" },
          { id: "gruppierungen", titel: "Gruppierungen" },
          { id: "gesetze", titel: "Gesetze" },
          { id: "politik", titel: "Politik" }
        ] -%}
      <nav class="chapter-nav reveal" aria-label="Abschnitte">
        {%- for k in abschnitte %}
        <a href="#{{ k.id }}">{{ k.titel }}</a>
        {%- endfor %}
      </nav>

      <div class="prose reveal">{{ content | safe }}</div>
    </div>
  </div>

  <section class="listing">
    <h2 class="section-title">Orte &amp; Gruppierungen</h2>
    <div class="card-grid">
      {%- set gruppen = collections.gruppierung | default([]) -%}
      {%- for g in gruppen | sort(attribute="data.ordnung") -%}
      {%- if g.data.grafschaft == slug %}
      <a
        class="card reveal"
        href="{{ g.url | url }}"
        style="--accent: {{ g.data.accent or site.accent }}"
      >
        {%- set kbild = g.data.bild or '/assets/img/og-default.png' -%}
        <div
          class="card-img"
          style="background-image: url('{{ kbild | url }}{{ kbild | v }}')"
        ></div>
        <div class="card-body">
          <h3 class="card-title">{{ g.data.name }}</h3>
          {%- if g.data.untertitel %}
          <p class="card-kicker">{{ g.data.untertitel }}</p>
          {%- endif %}
          {%- if g.data.beschreibung %}
          <p class="card-text">{{ g.data.beschreibung }}</p>
          {%- endif %}
        </div>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </section>
</article>
