---
layout: layouts/base.njk
---
<article class="page page--gruppierung">
  {%- set heroBild = bild or '/assets/img/og-default.png' -%}
  <div class="stage" style="--hero-img: url('{{ heroBild | url }}{{ heroBild | v }}')">
    <div class="stage-inner">
      <section class="hero hero--wide">
        <div class="hero-inner reveal">
          <p class="kicker">{{ grafschaftName }}</p>
          <h1 class="hero-title">{{ name }}</h1>
          {%- if untertitel %}<p class="hero-sub">{{ untertitel }}</p>{%- endif %}
          <div class="rule"><span>✦</span></div>
        </div>
      </section>

      <div class="prose reveal">{{ content | safe }}</div>
    </div>
  </div>

  <section class="listing">
    <h2 class="section-title">Charaktere</h2>
    <div class="card-grid card-grid--portrait">
      {%- set leute = collections.charakter | default([]) -%}
      {%- for c in leute | sort(attribute="data.ordnung") -%}
      {%- if c.data.gruppierung == slug %}
      <a
        class="card card--portrait reveal"
        href="{{ c.url | url }}"
        style="--accent: {{ c.data.accent or accent or site.accent }}"
      >
        {%- set kbild = c.data.bild or '/assets/img/og-default.png' -%}
        <div
          class="card-img card-img--tall"
          style="background-image: url('{{ kbild | url }}{{ kbild | v }}')"
        ></div>
        <div class="card-body">
          <h3 class="card-title">{{ c.data.name }}</h3>
          {%- if c.data.untertitel %}
          <p class="card-kicker">{{ c.data.untertitel }}</p>
          {%- endif %}
        </div>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </section>
</article>
