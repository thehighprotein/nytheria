---
layout: layouts/base.njk
---
<article class="page page--charakter">
  {%- set heroBild = bild or '/assets/img/og-default.png' -%}
  {# Bild als durchgehender Hintergrund hinter Titel, Tabs und Text. #}
  <div class="stage" style="--hero-img: url('{{ heroBild | url }}{{ heroBild | v }}')">
    <div class="stage-inner">
      <section class="hero hero--portrait">
        <div class="hero-inner reveal">
          <p class="kicker">{{ gruppierungName }}</p>
          <h1 class="hero-title">{{ name }}</h1>
          {%- if untertitel %}<p class="hero-sub">{{ untertitel }}</p>{%- endif %}
          <div class="rule"><span>✦</span></div>
        </div>
      </section>

      {# --- Kapitel-Navigation (Anker-Links wie #prolog) --- #}
      {%- set kapitel = kapitel or [
          { id: "prolog", titel: "Prolog" },
          { id: "herkunft", titel: "Herkunft" },
          { id: "wesen", titel: "Wesen" },
          { id: "verbindungen", titel: "Verbindungen" }
        ] -%}
      <nav class="chapter-nav reveal" aria-label="Kapitel">
        {%- for k in kapitel %}
        <a href="#{{ k.id }}">{{ k.titel }}</a>
        {%- endfor %}
      </nav>

      <div class="prose prose--drop reveal">{{ content | safe }}</div>
    </div>
  </div>

  {%- if galerie %}
  <section class="listing reveal">
    <h2 class="section-title">Augenblicke</h2>
    <button type="button" class="btn btn--solid" data-modal="modal-galerie">
      Galerie oeffnen
    </button>
  </section>
  {%- endif %}
</article>
