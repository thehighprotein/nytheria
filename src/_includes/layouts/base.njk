<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include "partials/head.njk" %}
  </head>
  <body style="--accent: {{ accent or site.accent }}">
    <div class="grain" aria-hidden="true"></div>

    {% include "partials/topbar.njk" %}

    <main>{{ content | safe }}</main>

    <footer class="site-footer">
      <p>{{ site.name }}</p>
      <p class="footer-fine">
        Alle Inhalte gehoeren dem Urheber dieser Seite.
      </p>
    </footer>

    {% include "partials/modals.njk" %}

    {# Hintergrundmusik — nur auf Seiten mit gesetztem "musik"-Feld. #}
    {%- if musik %}
    <audio
      id="bg-music"
      loop
      preload="none"
      src="{{ musik | url }}{{ musik | v }}"
    ></audio>
    {%- endif %}

    <script src="{{ '/assets/js/main.js' | url }}?v={{ assets.jsVersion }}" defer></script>
  </body>
</html>
