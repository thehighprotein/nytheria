{# Schmale, mitscrollende Kopfleiste #}
<header class="topbar">
  <nav class="topnav" aria-label="Navigation">
    {# Heimat: Grafschaft (Startseite) — Button-Optik #}
    {%- if grafschaftName and grafschaftUrl %}
    <a class="iconbtn" href="{{ grafschaftUrl | url }}">{{ grafschaftName }}</a>
    {%- endif %}

    {# Auswahl: Button, der per Klick ein Dropdown aller Fraktionen oeffnet #}
    {%- set fraktionen = collections.gruppierung | default([]) | sort(attribute="data.ordnung") -%}
    {%- if fraktionen | length %}
    <details class="auswahl">
      <summary class="iconbtn">Auswahl</summary>
      <ul class="auswahl-menu">
        {%- for f in fraktionen %}
        <li>
          <a
            href="{{ f.url | url }}"
            {%- if gruppierung and f.data.gruppierung == gruppierung %} aria-current="page"{% endif %}
          >{{ f.data.name }}</a>
        </li>
        {%- endfor %}
      </ul>
    </details>
    {%- endif %}

    {# Abwaerts-Uebergang: Buttons fuer ALLE Unterseiten der aktuellen Ebene #}
    {%- set kinder = [] -%}
    {%- if tags and ("grafschaft" in tags) -%}
      {%- set kinder = collections.gruppierung | default([]) | filterBy("data.grafschaft", slug) | sort(attribute="data.ordnung") -%}
    {%- elif tags and ("gruppierung" in tags) -%}
      {%- set kinder = collections.charakter | default([]) | filterBy("data.gruppierung", slug) | sort(attribute="data.ordnung") -%}
    {%- endif -%}
    {%- for kind in kinder %}
    <a class="iconbtn" href="{{ kind.url | url }}">{{ kind.data.name }}</a>
    {%- endfor %}
  </nav>

  <div class="topbar-actions">
    {%- if galerie %}
    <button type="button" class="iconbtn" data-modal="modal-galerie">Galerie</button>
    {%- endif %}
    <button type="button" class="iconbtn" data-modal="modal-hinweise">Hinweise</button>
    {%- if musik %}
    <button
      type="button"
      class="iconbtn musicbtn"
      id="music-toggle"
      aria-pressed="false"
      title="Hintergrundmusik an/aus"
    >
      <span class="music-on">♪ Musik</span>
      <span class="music-off">♪ Stumm</span>
    </button>
    {%- endif %}
  </div>
</header>
